{
  "name": "commitguard-kynsec",
  "displayName": "CommitGuard Security Scanner (KynSec)",
  "description": "Offline-first CommitGuard security diagnostics, rule-database scans, interprocedural taint for Python/JS/TS/Java/Go, and GUI launcher.",
  "version": "1.0.1",
  "publisher": "AmrKhaledEldhshan",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/KynSec/CommitGuard.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other",
    "Testing",
    "SCM Providers"
  ],
  "keywords": [
    "security",
    "sast",
    "secrets",
    "lsp",
    "commitguard",
    "pre-commit",
    "git",
    "code-scanning",
    "vulnerability",
    "static-analysis",
    "devsecops",
    "owasp",
    "taint-analysis",
    "gitleaks",
    "semgrep",
    "devskim",
    "nuclei",
    "python",
    "javascript",
    "typescript",
    "java",
    "go",
    "rust",
    "php",
    "offline",
    "privacy",
    "secret-detection",
    "dependency-scanning",
    "supply-chain"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "badges": [
    {
      "url": "https://img.shields.io/badge/offline-100%25-brightgreen",
      "href": "https://github.com/KynSec/CommitGuard",
      "description": "100% Offline"
    },
    {
      "url": "https://img.shields.io/badge/zero-telemetry-blue",
      "href": "https://github.com/KynSec/CommitGuard",
      "description": "Zero Telemetry"
    }
  ],
  "galleryBanner": {
    "color": "#080c14",
    "theme": "dark"
  },
  "contributes": {
    "commands": [
      {
        "command": "commitguard.restartServer",
        "title": "CommitGuard: Restart Language Server"
      },
      {
        "command": "commitguard.openPanel",
        "title": "CommitGuard: Open Scan Panel"
      },
      {
        "command": "commitguard.openGui",
        "title": "CommitGuard: Open GUI",
        "icon": "$(browser)"
      },
      {
        "command": "commitguard.scanCurrentFile",
        "title": "CommitGuard: Scan Current File",
        "icon": "$(search)"
      },
      {
        "command": "commitguard.scanStaged",
        "title": "CommitGuard: Scan Staged Changes",
        "icon": "$(git-commit)"
      },
      {
        "command": "commitguard.scanRepo",
        "title": "CommitGuard: Scan Full Repository",
        "icon": "$(repo)"
      },
      {
        "command": "commitguard.exportResults",
        "title": "CommitGuard: Export Results as JSON"
      },
      {
        "command": "commitguard.showDashboard",
        "title": "CommitGuard: Show Dashboard",
        "icon": "$(graph)"
      },
      {
        "command": "commitguard.clearResults",
        "title": "CommitGuard: Clear Results"
      }
    ],
    "configuration": {
      "title": "CommitGuard",
      "properties": {
        "commitguard.executable": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path or command for the CommitGuard CLI. Leave empty to auto-detect the workspace wrapper, a Python installation, or commit-guard on PATH."
        },
        "commitguard.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Optional Python interpreter used to launch CommitGuard with -m install_hook when the commit-guard launcher is not on PATH."
        },
        "commitguard.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments passed before the lsp subcommand."
        },
        "commitguard.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the LSP transport for troubleshooting."
        },
        "commitguard.scanOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically scan staged changes when a file is saved."
        },
        "commitguard.autoScanScope": {
          "type": "string",
          "enum": [
            "staged",
            "repo"
          ],
          "default": "staged",
          "description": "Scope used for auto-scan on save."
        },
        "commitguard.defaultSources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Rule databases pre-selected when the scan panel opens."
        },
        "commitguard.showFindingCount": {
          "type": "boolean",
          "default": true,
          "description": "Show the finding count in the status bar after a scan."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "commitguard",
          "title": "CommitGuard",
          "icon": "media/commitguard.svg"
        }
      ]
    },
    "views": {
      "commitguard": [
        {
          "id": "commitguard.scanView",
          "name": "Scan",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "commitguard.openGui",
          "when": "view == commitguard.scanView",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "commitguard.scanCurrentFile",
          "when": "resourceScheme == file",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "commitguard.scanCurrentFile",
          "group": "commitguard"
        }
      ],
      "scm/title": [
        {
          "command": "commitguard.scanStaged",
          "group": "commitguard"
        }
      ]
    },
    "keybindings": [
      {
        "command": "commitguard.scanStaged",
        "key": "ctrl+shift+g s",
        "mac": "cmd+shift+g s"
      },
      {
        "command": "commitguard.openPanel",
        "key": "ctrl+shift+g p",
        "mac": "cmd+shift+g p"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && npm run bundle",
    "bundle": "node esbuild.mjs",
    "package": "vsce package",
    "watch": "tsc -watch -p ./",
    "test": "node test/resolve.test.js && node test/scan.test.js && node test/panel.test.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.4.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "CommitGuard starts a local language server and executes workspace tools."
    }
  }
}
